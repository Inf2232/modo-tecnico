---
import WhatsAppButton from "./WhatsAppButton.astro";
import { messages } from "../lib/whatsapp";
import { contact } from "../config/contact";
import { isDefined } from "../config/site";

interface Props {
  title?: string;
  text?: string;
  message?: string;
}

const {
  title = "¿Tu PC o notebook está dando problemas?",
  text = "Cuéntanos qué pasa y te orientamos sobre los próximos pasos.",
  message = messages.consulta,
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="cta-titulo">
  <div
    class="rounded-2xl border border-borde bg-[linear-gradient(135deg,rgba(10,132,255,0.2),rgba(0,212,255,0.05))] px-6 py-12 text-center sm:px-12"
  >
    <h2 id="cta-titulo" class="text-3xl font-bold">{title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-texto-suave">{text}</p>
    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href="/contacto"
        class="inline-block rounded-lg bg-primario px-6 py-3 text-center font-semibold text-white transition-colors hover:bg-acento hover:text-fondo focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acento"
      >
        Solicitar diagnóstico
      </a>
      {isDefined(contact.whatsapp) && (
        <WhatsAppButton variant="outline" message={message} />
      )}
    </div>
  </div>
</section>