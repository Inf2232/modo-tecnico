---
const razones = [
  "Diagnóstico antes de reparar",
  "Presupuesto claro",
  "Atención personalizada",
  "Soporte técnico",
  "Desarrollo y conocimientos informáticos",
];
---

<section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="porque-titulo">
  <h2 id="porque-titulo" class="text-3xl font-bold">Por qué Modo Técnico</h2>
  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {razones.map((razon) => (
      <li class="flex items-center gap-3 rounded-lg border border-borde bg-superficie px-4 py-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0 text-acento"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span>{razon}</span>
      </li>
    ))}
  </ul>
</section>