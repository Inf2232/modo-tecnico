---
import { site, nav, isDefined } from "../config/site";
import { contact } from "../config/contact";

const year = new Date().getFullYear();

const redes = [
  { label: "Instagram", href: contact.social.instagram },
  { label: "Facebook", href: contact.social.facebook },
  { label: "GitHub", href: contact.social.github },
].filter((red) => isDefined(red.href));

const whatsappHref = isDefined(contact.whatsapp)
  ? `https://wa.me/${contact.whatsapp}`
  : null;
---

<footer class="mt-auto border-t border-borde bg-superficie">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-lg font-bold">{site.name}</p>
      <p class="mt-1 text-sm text-texto-suave">Informática práctica</p>
      <p class="mt-3 text-sm text-texto-suave">{site.city}, {site.country}</p>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="text-sm font-semibold uppercase tracking-wide">Navegación</h2>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-texto-suave hover:text-acento">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide">Contacto</h2>
      <ul class="mt-3 space-y-2 text-sm text-texto-suave">
        <li>{contact.location}</li>
        {isDefined(contact.serviceArea) && <li>Zona de servicio: {contact.serviceArea}</li>}
        {isDefined(contact.hours) && <li>Horarios: {contact.hours}</li>}
        {isDefined(contact.phone) && (
          <li><a href={`tel:${contact.phone}`} class="hover:text-acento">{contact.phone}</a></li>
        )}
        {isDefined(contact.email) && (
          <li><a href={`mailto:${contact.email}`} class="hover:text-acento">{contact.email}</a></li>
        )}
        {whatsappHref && (
          <li><a href={whatsappHref} class="hover:text-acento">WhatsApp</a></li>
        )}
      </ul>
    </div>

    {redes.length > 0 && (
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide">Redes</h2>
        <ul class="mt-3 space-y-2">
          {redes.map((red) => (
            <li>
              <a
                href={red.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-texto-suave hover:text-acento"
              >
                {red.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="border-t border-borde">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-4 text-sm text-texto-suave sm:flex-row sm:justify-between">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <a href="/privacidad" class="hover:text-acento">Política de privacidad</a>
    </div>
  </div>
</footer>