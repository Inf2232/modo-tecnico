---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm";
import { services } from "../data/services";
import { contact } from "../config/contact";
import { isDefined, site } from "../config/site";

const whatsappNumber = isDefined(contact.whatsapp) ? contact.whatsapp : null;
const servicios = services.map((s) => s.name);
---

<Layout
  title="Solicitar diagnóstico"
  description={`Cuéntanos qué le pasa a tu equipo y te orientamos. Soporte informático en ${site.city}.`}
>
  <main>
    <section class="mx-auto max-w-2xl px-4 py-16">
      <h1 class="text-4xl font-bold tracking-tight">Solicitar diagnóstico</h1>
      <p class="mt-3 text-lg text-texto-suave">
        Completa el formulario y se abrirá WhatsApp con tu consulta ya escrita.
      </p>
      <div class="mt-8">
        <ContactForm client:visible whatsappNumber={whatsappNumber} services={servicios} />
      </div>
    </section>
  </main>
</Layout>