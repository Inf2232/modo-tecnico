---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
---

<Layout title="Servicio técnico de PC y notebooks en Montevideo">
  <main class="p-8">
    <h1 class="text-3xl font-bold">{site.name} · {site.city}</h1>
    <p class="mt-2 text-texto-suave">Informática práctica</p>
    <a
      href="#"
      class="mt-6 inline-block rounded-lg bg-primario px-5 py-3 font-semibold text-white hover:bg-acento hover:text-fondo"
    >
      Solicitar diagnóstico
    </a>
  </main>
</Layout>