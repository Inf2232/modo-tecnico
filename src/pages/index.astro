---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import ProcessSection from "../components/ProcessSection.astro";
import WhyUs from "../components/WhyUs.astro";
import { services } from "../data/services";
import CTA from "../components/CTA.astro";

const destacados = services.filter((s) => s.featured);
---

<Layout title="Servicio técnico de PC y notebooks en Montevideo">
  <main>
    <Hero />

    <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="servicios-titulo">
      <h2 id="servicios-titulo" class="text-3xl font-bold">Soluciones para tu equipo</h2>
      <p class="mt-2 text-texto-suave">Estos son algunos de los servicios principales.</p>
      <div class="mt-8">
        <ServiceGrid services={destacados} />
      </div>
      <a href="/servicios" class="mt-8 inline-block font-semibold text-acento hover:underline">
        Ver todos los servicios →
      </a>
    </section>

    <ProcessSection />
    <WhyUs />
    <CTA />
  </main>
</Layout>